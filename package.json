{
  "name": "teste-pratico-01",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mini sistema com sidebar retratil e geracao de PDF com marca d'agua - base para teste pratico com OpenSpec",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "codegen": "playwright codegen http://localhost:5173",
    "openspec": "openspec"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
